# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# ---- 数据库 ----
# 首次运行由生成器自动创建，不入库（保证克隆后可完整复现）
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# ---- 导出产物 ----
# 由 export.bat 生成，随时可重跑，不入库
data/export/*
!data/export/.gitkeep

# ---- 密钥与环境 ----
.env
.env.local
secrets.*
*.key

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器 ----
.vscode/
.idea/
*.swp

# ---- 输出 ----
*.log

# ---- 本地备份 ----
data/*.bak_*

# ---- 误克隆进项目目录的同名仓库（2026-10-17），仅防误提交 ----
/game-ops-portfolio/

# ---- 误克隆进项目目录的同名仓库（2026-10-17），仅防误提交 ----
/game-ops-portfolio/

# ---- Agent 本地记忆（不入库） ----
